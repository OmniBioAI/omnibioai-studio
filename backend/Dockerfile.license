# OmniBioAI — Studio License Service
# Purpose: Build the FastAPI license service container.
# Author: Manish Kumar <manish@omnibioai.org>

FROM python:3.11-slim

WORKDIR /app

# Python dependencies
RUN pip install fastapi uvicorn pymysql sqlalchemy requests --no-cache-dir

COPY license_server.py .

EXPOSE 8099

CMD ["uvicorn", "license_server:app", "--host", "0.0.0.0", "--port", "8099"]
