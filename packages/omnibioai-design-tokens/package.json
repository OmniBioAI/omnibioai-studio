  "description": "OmniBioAI unified design tokens",
  "main": "tokens.js",
  "types": "tokens.ts",
  "files": [
    "tokens.css",
    "tokens.js",
    "tokens.ts"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
