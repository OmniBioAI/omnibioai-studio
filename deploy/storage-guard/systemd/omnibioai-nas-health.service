[Unit]
Description=Publish OmniBioAI primary NAS health
Wants=network-online.target
After=network-online.target mnt-nas-omnibioai.mount

[Service]
Type=oneshot
User=root
Group=root
RuntimeDirectory=omnibioai
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
UMask=0022
ExecStart=/usr/bin/timeout --signal=KILL 20 /usr/local/libexec/omnibioai/omnibioai_nas_health.py
ExecStopPost=/usr/local/libexec/omnibioai/omnibioai_nas_health.py --service-result=${SERVICE_RESULT}
TimeoutStartSec=25
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET
ReadWritePaths=/run/omnibioai /mnt/nas/omnibioai
