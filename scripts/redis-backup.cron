# Redis backup schedule: credentials come from the script's protected external files.
# Set OMNIBIOAI_ROOT and REDIS_BACKUP_* in the cron environment or wrapper.
*/5 * * * * cd "${OMNIBIOAI_ROOT}" && "${OMNIBIOAI_ROOT}/scripts/backup-redis.sh" >> "${WORK_DIR}/backups/omnibioai-redis-backup.log" 2>&1
